{{!-- Character sheet (v14). Removed helpers: {{select}} and {{colorPicker}}.
     Use {{formInput}} for schema-backed fields and {{selectOptions}} inside a <select>.
     Rows carrying data-item-id or data-effect-id need the `draggable` class:
     ActorSheetV2 binds its built-in DragDrop to the `.draggable` selector. --}}

{{!-- Identity --}}
<section class="identity">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" />
  <input class="charname" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'MY_SYSTEM.CharacterName'}}" />
  <label class="level-badge">
    {{localize 'MY_SYSTEM.Level'}}
    {{formInput systemFields.level value=system.level}}
  </label>
</section>

{{!-- Attributes --}}
<section class="attributes">
  <h2>{{localize 'MY_SYSTEM.Sections.Attributes'}}</h2>
  <div class="ability-grid">
    {{#each abilities as |ability|}}
      <div class="ability" data-ability="{{ability.key}}">
        <label>{{ability.label}}</label>
        <input type="number" name="system.abilities.{{ability.key}}.value" value="{{ability.value}}" min="1" max="20" />
        <span class="ability-mod">{{numberFormat ability.mod sign=true}}</span>
        <button type="button" data-action="rollAbility" data-ability="{{ability.key}}" title="{{localize 'MY_SYSTEM.Roll'}}">
          <i class="fa-solid fa-dice-d20"></i>
        </button>
      </div>
    {{/each}}
  </div>
</section>

{{!-- Health --}}
<section class="health">
  <h2>{{localize 'MY_SYSTEM.Sections.Health'}}</h2>
  <div class="health-bar">
    {{formInput systemFields.health.fields.value value=system.health.value}}
    <span class="separator">/</span>
    <span class="health-max">{{system.health.max}}</span>
  </div>
</section>

{{!-- Inventory --}}
<section class="inventory">
  <h2>
    {{localize 'MY_SYSTEM.Sections.Inventory'}}
    <button type="button" data-action="addItem" data-type="weapon" title="{{localize 'MY_SYSTEM.AddItem'}}">
      <i class="fa-solid fa-plus"></i>
    </button>
  </h2>
  <ul class="items-list">
    {{#each weapons as |item|}}
      <li class="item draggable" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="{{item.name}}" width="24" height="24" />
        <span class="item-name">{{item.name}}</span>
        <span class="item-damage">{{item.system.damage}}</span>
        <button type="button" data-action="rollItem" title="{{localize 'MY_SYSTEM.Roll'}}">
          <i class="fa-solid fa-dice-d20"></i>
        </button>
        <button type="button" data-action="deleteItem" title="{{localize 'MY_SYSTEM.DeleteItem'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
    {{/each}}
  </ul>
</section>

{{!-- Effects --}}
<section class="effects">
  <h2>{{localize 'MY_SYSTEM.Sections.Effects'}}</h2>
  <ul class="effects-list">
    {{#each effects as |effect|}}
      <li class="effect draggable {{#if effect.disabled}}disabled{{/if}}" data-effect-id="{{effect.id}}">
        <img src="{{effect.img}}" alt="{{effect.name}}" width="24" height="24" />
        <span class="effect-name">{{effect.name}}</span>
        <span class="effect-changes">{{effect.changes}}</span>
      </li>
    {{/each}}
  </ul>
</section>

{{!-- Biography --}}
<section class="biography">
  <h2>{{localize 'MY_SYSTEM.Sections.Biography'}}</h2>
  {{#if editable}}
    {{!-- `toggled` is a boolean attribute: its presence enables the toggle. The
         element body is the enriched preview shown while the editor is closed. --}}
    <prose-mirror name="system.biography" value="{{system.biography}}" toggled>{{{enrichedBiography}}}</prose-mirror>
  {{else}}
    {{{enrichedBiography}}}
  {{/if}}
</section>
