{
  "id": "my-system",
  "title": "My System",
  "description": "A custom game system for Foundry VTT.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Your Name",
      "url": "https://github.com/yourname"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": ["biography"],
        "filePathFields": {
          "portrait": ["IMAGE"]
        }
      },
      "npc": {
        "htmlFields": ["biography"]
      }
    },
    "Item": {
      "weapon": {
        "htmlFields": ["description"],
        "filePathFields": {
          "img": ["IMAGE"]
        }
      },
      "spell": {
        "htmlFields": ["description"],
        "filePathFields": {
          "img": ["IMAGE"]
        }
      }
    }
  },
  "background": "systems/my-system/assets/background.webp",
  "gridDistance": 5,
  "gridUnits": "ft",
  "primaryTokenAttribute": "health",
  "secondaryTokenAttribute": "power",
  "esmodules": ["main.mjs"],
  "styles": ["styles/my-system.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "core-items",
      "label": "Core Items",
      "path": "packs/core-items",
      "type": "Item",
      "system": "my-system"
    },
    {
      "name": "core-spells",
      "label": "Core Spells",
      "path": "packs/core-spells",
      "type": "Item",
      "system": "my-system"
    },
    {
      "name": "core-npcs",
      "label": "Core NPCs",
      "path": "packs/core-npcs",
      "type": "Actor",
      "system": "my-system"
    }
  ],
  "packFolders": [
    {
      "name": "Core Content",
      "color": "#7a4",
      "packs": ["core-npcs"],
      "folders": [
        {
          "name": "Equipment",
          "color": "#a47",
          "packs": ["core-items", "core-spells"]
        }
      ]
    }
  ],
  "relationships": {
    "requires": [],
    "systems": [],
    "modules": []
  },
  "socket": true,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles/my-system.css", "templates", "lang"]
    },
    "my-system": {
      "needsMigrationVersion": "1.0.0",
      "compatibleMigrationVersion": "0.5.0"
    }
  }
}
