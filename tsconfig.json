{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["skills/*/boilerplate/**/*.ts", "skills/*/templates/**/*.ts"],
  "exclude": [
    "node_modules",
    "skills/claude-agent-sdk",
    "skills/database-performance-tuning",
    "skills/foundry-vtt-dev",
    "skills/openclaw-genie",
    "skills/react-animations"
  ]
}
